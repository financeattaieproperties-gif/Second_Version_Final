rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net — deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Shared Hardened Primitives ───────────────────────────────────────────
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ── Schema Validators ────────────────────────────────────────────────────
    function isValidUserProfile(data) {
      return data is map
        && data.keys().hasAll(['uid', 'displayName', 'photoURL', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'role', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.displayName is string
        && data.displayName.size() <= 120
        && data.photoURL is string
        && data.photoURL.size() <= 512
        && data.role is string
        && data.role.size() <= 32
        && data.role in ['member', 'staff', 'admin']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data) {
      return data is map
        && data.keys().hasAll(['uid', 'email', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'updatedAt'])
        && isValidId(data.uid)
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.updatedAt is timestamp;
    }

    // ── Connection Check Document (read-only single doc probe) ───────────────
    match /test/connection {
      allow get: if true;
      allow list, create, update, delete: if false;
    }

    // ── Trusted Admin Allowlist (console / admin SDK managed) ────────────────
    match /admins/{userId} {
      allow get: if isOwner(userId) && isVerifiedUser();
      allow list, create, update, delete: if false;
    }

    // ── User Display Profiles (zero PII) ─────────────────────────────────────
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == request.auth.uid
        && incoming().role == 'member'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidUserProfile(incoming())
        && (
          (
            isAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'role', 'updatedAt'])
            && incoming().uid == existing().uid
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
          )
          ||
          (
            isOwner(userId)
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt'])
            && incoming().uid == existing().uid
            && incoming().role == existing().role
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
          )
        );

      allow delete: if isAdmin();

      // ── Private Account Subcollection (PII isolation) ──────────────────────
      match /private/{docId} {
        allow get: if (isOwner(userId) && isVerifiedUser()) || isAdmin();
        allow list: if isSignedIn()
          && request.auth.uid == userId
          && resource.data.uid == request.auth.uid;

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(docId)
          && isOwner(userId)
          && isValidUserPrivateInfo(incoming())
          && incoming().uid == request.auth.uid
          && incoming().updatedAt == request.time;

        allow update: if isVerifiedUser()
          && isOwner(userId)
          && isValidUserPrivateInfo(incoming())
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt'])
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time;

        allow delete: if (isOwner(userId) && isVerifiedUser()) || isAdmin();
      }
    }
  }
}
